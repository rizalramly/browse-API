# Copy to .env and adjust. Never commit .env.
APP_ENV=dev
LOG_LEVEL=INFO

# Per-key token bucket (qps <= 0 disables rate limiting)
RATE_LIMIT_QPS=5
RATE_LIMIT_BURST=10

# Provider resilience
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_SECONDS=0.5
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_SECONDS=30

# Direct-scrape stub stays off until implemented + compliance sign-off
DIRECT_SCRAPE_ENABLED=false

# Infrastructure (service names resolve inside docker compose)
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://gen:gen@postgres:5432/gen
SEARXNG_URL=http://searxng:8080

# Postgres container bootstrap
POSTGRES_USER=gen
POSTGRES_PASSWORD=gen
POSTGRES_DB=gen

# SearXNG
SEARXNG_SECRET=change-me-to-a-long-random-string

# Vault (optional — env vars are the dev fallback)
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=
# VAULT_MOUNT=secret
# VAULT_PATH=gen-api

# Commercial Gen-compatible provider (Phase 3). Set both to activate
# places/shopping/scholar/patents and optional /search enrichment.
# COMMERCIAL_BASE_URL=
# COMMERCIAL_API_KEY=
# SEARCH_ENRICHMENT=false
